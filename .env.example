# porta e endereço público (o APP_URL monta o webhook da uazapi — ver README)
PORT=8795
APP_URL=http://localhost:8795

# acesso ao painel
PAINEL_SENHA=troque-por-um-token-aleatorio
PAINEL_EMAIL=voce@exemplo.com
PAINEL_SENHA_LOGIN_HASH=
WEBHOOK_SECRET=troque-tambem

# WhatsApp (sem isso sobe em modo demo)
UAZAPI_URL=
UAZAPI_ADMIN_TOKEN=

# IA — escolha UM dos dois:
#   modo cliente: API paga, chave do próprio cliente
SDR_IA_MODO=
ANTHROPIC_API_KEY=
#   modo interno: plano da VPS, custo zero de token
CLAUDE_CODE_OAUTH_TOKEN=

# Google Agenda (botão "Conectar agenda")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# alerta no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# marca branca: vazio = operação interna (Facilita)
CLIENTE_NOME=
SDR_PROMPT=sdr-generico.md
DADOS_DIR=./dados

# Foto do lead no CRM: vem da foto de perfil do WhatsApp (uazapi, sem custo, ja
# funciona com um chip conectado). OPCIONAL: chave da Places API (New) do Google
# pra usar a foto do Google Meu Negocio quando o WhatsApp do lead nao tem foto
# (cobrada por busca). Fotos ficam em dados/fotos e renovam a cada 7 dias.
GOOGLE_PLACES_KEY=

# Meta Ads (API de Conversoes): pixel e token sao configurados pelo painel em
# Configuracoes > Integracoes > Meta Ads. Aqui so a versao da Graph API (opcional).
META_API_VERSION=v23.0
